[Unit]
Description=Electrical Component Tracker (Flask + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracker
Group=tracker
WorkingDirectory=/opt/component-tracker
# Generate a real value: openssl rand -hex 32  (then paste it below)
Environment=TRACKER_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
ExecStart=/opt/component-tracker/venv/bin/gunicorn -c /opt/component-tracker/deploy/gunicorn.conf.py app:app
Restart=on-failure
RestartSec=3

# Light hardening — the app only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/component-tracker/data

[Install]
WantedBy=multi-user.target
